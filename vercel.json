{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": ".",
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": "/api/v1/:path*"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}